          <mxGeometry x="660" y="30" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="auth-r5" value="INSERT auth.users&lt;br&gt;RETURNING id&lt;br&gt;409 duplicate · 500 DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="auth-register">
          <mxGeometry x="910" y="30" width="210" height="70" as="geometry"/>
