        <mxCell id="uploads-startup" value="startup: db.Connect → db.Migrate (uploads schema) → mkdir uploadDir → jwt → clients NSFW/gore → Serve" style="text;html=1;align=left;fontSize=11;fontColor=#5A626E;" vertex="1" parent="uploads-svc">
