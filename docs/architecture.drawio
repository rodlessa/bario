        <mxCell id="uploads-u2" value="MaxBytesReader 10 MiB&lt;br&gt;ParseMultipartForm&lt;br&gt;413 / 400" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="uploads-upload">
