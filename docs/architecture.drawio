        <mxCell id="posts-lane-list" value="GET /users/{id}/posts — handleListUserPosts — public profile timeline" style="swimlane;startSize=22;fillColor=#FFFFFF;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="posts-svc">
