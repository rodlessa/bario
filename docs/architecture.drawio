          <mxGeometry x="570" y="30" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ads-c4" value="201 created&lt;br&gt;200 list&lt;br&gt;200 updated · 404 not found/not owned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="ads-crud">
          <mxGeometry x="890" y="30" width="230" height="80" as="geometry"/>
