        <mxCell id="ads-startup" value="startup: db.Connect → db.Migrate (ads schema) → jwt.Manager → authclient (AUTH_URL) → Serve :8087 / :9097" style="text;html=1;align=left;fontSize=11;fontColor=#5A626E;" vertex="1" parent="ads-svc">
          <mxGeometry x="20" y="28" width="1120" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="ads-crud" value="POST /ads · GET /ads · PATCH /ads/{id}" style="swimlane;startSize=22;fillColor=#FFFFFF;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="ads-svc">
          <mxGeometry x="20" y="50" width="1140" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="ads-c1" value="POST /ads · GET /ads&lt;br&gt;PATCH /ads/{id}&lt;br&gt;RequireAuth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="ads-crud">
          <mxGeometry x="20" y="30" width="210" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ads-c2" value="validate&lt;br&gt;create: title 1–120, body 1–2000,&lt;br&gt;budget ≥0; update: active|paused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="ads-crud">
