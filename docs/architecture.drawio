        </mxCell>
        <mxCell id="auth-login" value="POST /login — handleLogin" style="swimlane;startSize=22;fillColor=#FFFFFF;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="auth-svc">
          <mxGeometry x="20" y="210" width="1140" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="auth-l1" value="POST /login&lt;br&gt;/api/auth/login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="auth-login">
          <mxGeometry x="20" y="30" width="170" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auth-l2" value="SELECT id, username, hash,&lt;br&gt;is_admin, interests&lt;br&gt;WHERE username=$1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="auth-login">
          <mxGeometry x="210" y="30" width="210" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auth-l3" value="bcrypt.CompareHashAndPassword&lt;br&gt;401 invalid username/password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="auth-login">
          <mxGeometry x="440" y="30" width="230" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auth-l4" value="jwt.Issue&lt;br&gt;24h claims (id, username)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="auth-login">
          <mxGeometry x="690" y="30" width="220" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auth-l5" value="200 {token, user}&lt;br&gt;{id, username, is_admin,&lt;br&gt;interests}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="auth-login">
          <mxGeometry x="930" y="30" width="190" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auth-e-l1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="auth-login" source="auth-l1" target="auth-l2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auth-e-l2" value="row" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="auth-login" source="auth-l2" target="auth-l3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auth-e-l3" value="match" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="auth-login" source="auth-l3" target="auth-l4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auth-e-l4" value="token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="auth-login" source="auth-l4" target="auth-l5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auth-get" value="GET /users/{id} — handleGetUser" style="swimlane;startSize=22;fillColor=#FFFFFF;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="auth-svc">
          <mxGeometry x="20" y="350" width="1140" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="auth-g1" value="GET /users/{id}&lt;br&gt;/api/auth/users/{id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="auth-get">
          <mxGeometry x="20" y="30" width="190" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auth-g2" value="parseID&lt;br&gt;400 invalid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="auth-get">
          <mxGeometry x="230" y="30" width="140" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auth-g3" value="SELECT username, is_admin,&lt;br&gt;interests, created_at&lt;br&gt;404 not found · 500 DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="auth-get">
          <mxGeometry x="390" y="30" width="300" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auth-g4" value="200 public profile&lt;br&gt;{id, username, is_admin,&lt;br&gt;interests, created_at}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="auth-get">
          <mxGeometry x="710" y="30" width="220" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="auth-e-g1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="auth-get" source="auth-g1" target="auth-g2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auth-e-g2" value="id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="auth-get" source="auth-g2" target="auth-g3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auth-e-g3" value="user" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="auth-get" source="auth-g3" target="auth-g4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auth-semantics" value="&lt;b&gt;Auth semantics&lt;/b&gt;&lt;br&gt;JWT TTL 24h, signed with shared JWT_SECRET. Admin flag is assigned when username == ADMIN_USERNAME (default admin).&lt;br&gt;No outbound HTTP clients: auth only reads/writes auth.users. Other services call auth for usernames/interests; uploads validates JWTs locally." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="auth-svc">
          <mxGeometry x="20" y="490" width="1140" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="auth-deps" value="&lt;b&gt;Called by&lt;/b&gt;&lt;br&gt;posts: author usernames · follows: follower/following names · ads: caller interests · frontend: register/login/profile" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="1460" y="90" width="420" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="auth-pg" value="PostgreSQL 16 · schema auth" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="1460" y="260" width="420" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="auth-table" value="&lt;b&gt;auth.users&lt;/b&gt;&lt;br&gt;id BIGSERIAL PK&lt;br&gt;username TEXT NOT NULL UNIQUE&lt;br&gt;password_hash TEXT NOT NULL&lt;br&gt;email TEXT NOT NULL&lt;br&gt;is_admin BOOLEAN NOT NULL DEFAULT false&lt;br&gt;interests TEXT[] NOT NULL DEFAULT &#x27;{}&#x27;&lt;br&gt;created_at TIMESTAMPTZ NOT NULL DEFAULT now()" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FCFBFF;strokeColor=#B9A6F0;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="1460" y="355" width="420" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="auth-noout" value="No outbound client calls.&lt;br&gt;JWT is validated locally by every service with the shared secret; posts/follows/ads still call auth over HTTP for names/interests." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="1460" y="610" width="420" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="auth-e-client" value="/api/auth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="auth-client" target="auth-svc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auth-e-db" value="READ / WRITE auth.users" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B9A6F0;fontColor=#6B51A8;" edge="1" parent="1" source="auth-svc" target="auth-pg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="auth-fail" value="&lt;b&gt;Failure / degradation matrix&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=#B42318&gt;&lt;b&gt;DB failure&lt;/b&gt;&lt;/font&gt; → 500 could not create account / could not sign in / could not load user&lt;br&gt;&lt;font color=#B42318&gt;&lt;b&gt;duplicate username&lt;/b&gt;&lt;/font&gt; → 409 username is already taken&lt;br&gt;&lt;font color=#B42318&gt;&lt;b&gt;bad input&lt;/b&gt;&lt;/font&gt; → 400 (username regex, password 8–72, email, interests)&lt;br&gt;&lt;font color=#B42318&gt;&lt;b&gt;bad credentials&lt;/b&gt;&lt;/font&gt; → 401 invalid username or password (same response for unknown user and wrong password)&lt;br&gt;startup: DATABASE_URL / JWT_SECRET / ADMIN_USERNAME / HTTP_PORT / METRICS_PORT; migrations run automatically." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="900" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="auth-contract" value="&lt;b&gt;Contract&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST /register → 201 {id, username, is_admin, interests}&lt;br&gt;POST /login → 200 {token, user}&lt;br&gt;GET /users/{id} → 200 public profile · 404 · 400&lt;br&gt;&lt;br&gt;Every route is mounted both bare and under /api/auth. Metrics: service=auth, endpoints health/register/login/get_user." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="960" y="810" width="460" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="auth-legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;solid blue = sync HTTP / DB call&lt;br&gt;&lt;font color=#B42318&gt;red dashed = load-bearing failure (abort)&lt;/font&gt;&lt;br&gt;&lt;font color=#2E7D32&gt;green dashed = graceful degradation / fail-open&lt;/font&gt;&lt;br&gt;&lt;font color=#5A626E&gt;gray dashed = metrics scrape&lt;/font&gt;&lt;br&gt;purple = PostgreSQL / persistent storage&lt;br&gt;&lt;br&gt;&lt;b&gt;Runtime&lt;/b&gt;&lt;br&gt;HTTP :8080 · metrics :9090 (ClusterIP)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="1440" y="810" width="420" height="250" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bario-follows-001" name="follows service">
    <mxGraphModel dx="1900" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bario-follows-001-title" value="Bario — follows service (schema follows)" style="text;fontStyle=1;fontSize=16;html=1;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1300" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="bario-follows-001-sub" value="Directed follower graph · idempotent follow/unfollow · best-effort usernames" style="text;fontSize=12;html=1;fontColor=#5A626E;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1300" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="follows-client" value="Browser / Traefik ingress&lt;br&gt;/api/follows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="follows-svc" value="follows Deployment — Go · schema follows · API :8080 · metrics :9090" style="swimlane;startSize=26;fillColor=#F7F8FA;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="90" width="1180" height="700" as="geometry"/>
        </mxCell>
        <mxCell id="follows-startup" value="startup: db.Connect → db.Migrate (follows.follows) → jwt.Manager → authclient (AUTH_URL) → Serve" style="text;html=1;align=left;fontSize=11;fontColor=#5A626E;" vertex="1" parent="follows-svc">
          <mxGeometry x="20" y="28" width="1120" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="follows-mut" value="POST / DELETE /users/{id}/follow — mutate graph" style="swimlane;startSize=22;fillColor=#FFFFFF;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="follows-svc">
          <mxGeometry x="20" y="50" width="1140" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="follows-m1" value="POST /users/{id}/follow&lt;br&gt;DELETE /users/{id}/follow&lt;br&gt;/api/follows/...&lt;br&gt;RequireAuth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="follows-mut">
          <mxGeometry x="20" y="30" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="follows-m2" value="parseID&lt;br&gt;400 invalid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="follows-mut">
          <mxGeometry x="260" y="30" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="follows-m3" value="self-follow?&lt;br&gt;400 you cannot&lt;br&gt;follow yourself" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="follows-mut">
          <mxGeometry x="430" y="30" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="follows-m4" value="INSERT ... ON CONFLICT DO NOTHING&lt;br&gt;or DELETE WHERE follower=$1&lt;br&gt;AND followee=$2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="follows-mut">
          <mxGeometry x="630" y="30" width="330" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="follows-m5" value="201 {following:true}&lt;br&gt;204 unfollow&lt;br&gt;500 on DB error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="follows-mut">
          <mxGeometry x="980" y="30" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="follows-e-m1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="follows-mut" source="follows-m1" target="follows-m2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="follows-e-m2" value="id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="follows-mut" source="follows-m2" target="follows-m3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="follows-e-m3" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="follows-mut" source="follows-m3" target="follows-m4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="follows-e-m4" value="done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="follows-mut" source="follows-m4" target="follows-m5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="follows-list" value="GET /users/{id}/followers · /following — public lists" style="swimlane;startSize=22;fillColor=#FFFFFF;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="follows-svc">
          <mxGeometry x="20" y="260" width="1140" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="follows-l1" value="GET /users/{id}/followers&lt;br&gt;GET /users/{id}/following&lt;br&gt;(bare and /api/follows)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="follows-list">
          <mxGeometry x="20" y="30" width="250" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="follows-l2" value="parseID&lt;br&gt;400 invalid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="follows-list">
          <mxGeometry x="290" y="30" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="follows-l3" value="SELECT follower_id / followee_id&lt;br&gt;ORDER BY created_at DESC,&lt;br&gt;id DESC&lt;br&gt;no pagination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="follows-list">
          <mxGeometry x="460" y="30" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="follows-l4" value="authClient.Username&lt;br&gt;per id (best-effort)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="follows-list">
          <mxGeometry x="780" y="30" width="210" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="follows-l5" value="200 [{id,username}]&lt;br&gt;500 on DB error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="follows-list">
          <mxGeometry x="1010" y="30" width="110" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="follows-e-l1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="follows-list" source="follows-l1" target="follows-l2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="follows-e-l2" value="id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="follows-list" source="follows-l2" target="follows-l3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="follows-e-l3" value="ids" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="follows-list" source="follows-l3" target="follows-l4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="follows-e-l4" value="names" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="follows-list" source="follows-l4" target="follows-l5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="follows-note" value="&lt;b&gt;Graph semantics&lt;/b&gt;&lt;br&gt;Primary key (follower_id, followee_id) makes follow idempotent. Unfollow of a missing edge is still 204. Lists return every relation (no cursor/limit); clients should not assume a bound. Username lookup failure degrades to user-&amp;lt;id&gt;, it does not fail the list." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="follows-svc">
          <mxGeometry x="20" y="470" width="1140" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="follows-auth" value="auth service · :8080&lt;br&gt;GET /users/{id}&lt;br&gt;&lt;font color=#2E7D32&gt;best-effort: error → user-&amp;lt;id&gt;&lt;/font&gt;&lt;br&gt;list still returns 200" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="1460" y="90" width="420" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="follows-pg" value="PostgreSQL 16 · schema follows" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="1460" y="270" width="420" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="follows-table" value="&lt;b&gt;follows.follows&lt;/b&gt;&lt;br&gt;follower_id BIGINT NOT NULL&lt;br&gt;followee_id BIGINT NOT NULL&lt;br&gt;created_at TIMESTAMPTZ NOT NULL DEFAULT now()&lt;br&gt;PRIMARY KEY (follower_id, followee_id)&lt;br&gt;index follows_followee_id_idx (followee_id)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FCFBFF;strokeColor=#B9A6F0;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="1460" y="365" width="420" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="follows-callers" value="&lt;b&gt;Callers&lt;/b&gt;&lt;br&gt;posts feed: GET /users/{id}/following&lt;br&gt;the post service treats a follows error as load-bearing (502)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="1460" y="610" width="420" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="follows-e-client" value="/api/follows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="follows-client" target="follows-svc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="follows-e-auth" value="Username (best-effort)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#2E7D32;fontColor=#2E7D32;" edge="1" parent="1" source="follows-svc" target="follows-auth">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="follows-e-db" value="READ / WRITE follows.follows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B9A6F0;fontColor=#6B51A8;" edge="1" parent="1" source="follows-svc" target="follows-pg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="follows-fail" value="&lt;b&gt;Failure / degradation matrix&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=#B42318&gt;&lt;b&gt;DB error&lt;/b&gt;&lt;/font&gt; → 500 could not follow user / could not unfollow user / could not load users&lt;br&gt;&lt;font color=#B42318&gt;&lt;b&gt;self-follow&lt;/b&gt;&lt;/font&gt; → 400 you cannot follow yourself&lt;br&gt;&lt;font color=#B42318&gt;&lt;b&gt;bad id&lt;/b&gt;&lt;/font&gt; → 400 invalid id&lt;br&gt;&lt;font color=#2E7D32&gt;&lt;b&gt;auth username lookup down&lt;/b&gt;&lt;/font&gt; → names become user-&amp;lt;id&gt;; list still 200&lt;br&gt;follow errors are load-bearing only for posts&#x27; feed: posts returns 502 if FollowingIDs fails." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="900" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="follows-contract" value="&lt;b&gt;Contract&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST /users/{id}/follow → 201 {following:true}&lt;br&gt;DELETE /users/{id}/follow → 204&lt;br&gt;GET /users/{id}/followers · /following → 200 [{id,username}]&lt;br&gt;&lt;br&gt;Mutations require JWT; lists are public. Metrics: service=follows, endpoints health/follow_user/unfollow_user/list_followers/list_following." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="960" y="810" width="460" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="follows-legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;solid blue = sync HTTP / DB call&lt;br&gt;&lt;font color=#B42318&gt;red dashed = load-bearing failure (abort)&lt;/font&gt;&lt;br&gt;&lt;font color=#2E7D32&gt;green dashed = graceful degradation / fail-open&lt;/font&gt;&lt;br&gt;&lt;font color=#5A626E&gt;gray dashed = metrics scrape&lt;/font&gt;&lt;br&gt;purple = PostgreSQL / persistent storage&lt;br&gt;&lt;br&gt;&lt;b&gt;Runtime&lt;/b&gt;&lt;br&gt;HTTP :8080 · metrics :9090 (ClusterIP)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="1440" y="810" width="420" height="250" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="bario-ads-001" name="ads service">
