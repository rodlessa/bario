        <mxCell id="ads-s3" value="authClient.User&lt;br&gt;caller interests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="ads-serve">
          <mxGeometry x="490" y="30" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ads-s4" value="targeted: active AND&lt;br&gt;target_tags &amp;&amp; interests&lt;br&gt;ORDER BY id DESC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="ads-serve">
          <mxGeometry x="680" y="30" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ads-s5" value="general fill: active AND&lt;br&gt;target_tags = &#x27;{}&#x27;&lt;br&gt;remaining slots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="ads-serve">
          <mxGeometry x="940" y="30" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ads-e-s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="ads-serve" source="ads-s1" target="ads-s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ads-e-s2" value="count" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="ads-serve" source="ads-s2" target="ads-s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ads-e-s3" value="interests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="ads-serve" source="ads-s3" target="ads-s4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ads-e-s4" value="remaining" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="ads-serve" source="ads-s4" target="ads-s5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ads-s6" value="INSERT impressions&lt;br&gt;best-effort; failures logged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="ads-serve">
          <mxGeometry x="20" y="160" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ads-s7" value="200 [{id, advertiser_id,&lt;br&gt;title, body}]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="ads-serve">
          <mxGeometry x="300" y="160" width="250" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ads-e-s5" value="each ad" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="ads-serve" source="ads-s5" target="ads-s6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ads-e-s6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="ads-serve" source="ads-s6" target="ads-s7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ads-click" value="POST /ads/{id}/click — click tracking" style="swimlane;startSize=22;fillColor=#FFFFFF;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="ads-svc">
          <mxGeometry x="20" y="530" width="1140" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="ads-k1" value="POST /ads/{id}/click&lt;br&gt;RequireAuth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="ads-click">
          <mxGeometry x="20" y="30" width="220" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="ads-k2" value="INSERT clicks&lt;br&gt;WHERE EXISTS advertisement&lt;br&gt;404 if absent · 500 DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="ads-click">
          <mxGeometry x="270" y="30" width="360" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="ads-k3" value="204 · 404 · 500" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="ads-click">
          <mxGeometry x="660" y="30" width="180" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="ads-e-k1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="ads-click" source="ads-k1" target="ads-k2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ads-e-k2" value="recorded" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="ads-click" source="ads-k2" target="ads-k3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ads-note" value="&lt;b&gt;Serving semantics&lt;/b&gt;&lt;br&gt;Ads are re-rolled every request; inventory shortfall is not an error (returns what exists). Impressions are inserted per served ad, best-effort. This feeds posts&#x27; fail-open interleaving; posts does not treat ads as load-bearing." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="ads-svc">
          <mxGeometry x="20" y="680" width="1140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ads-auth" value="auth service · :8080&lt;br&gt;GET /users/{id} → interests&lt;br&gt;&lt;font color=#2E7D32&gt;best-effort: error → no interests,&lt;br&gt;general ads only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="1460" y="90" width="420" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="ads-pg" value="PostgreSQL 16 · schema ads" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="1460" y="260" width="420" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ads-t1" value="&lt;b&gt;ads.advertisements&lt;/b&gt;&lt;br&gt;id BIGSERIAL PK · advertiser_id BIGINT&lt;br&gt;title TEXT · body TEXT&lt;br&gt;target_tags TEXT[] DEFAULT &#x27;{}&#x27;&lt;br&gt;budget_cents BIGINT CHECK ≥0&lt;br&gt;status TEXT DEFAULT &#x27;active&#x27;&lt;br&gt;created_at/updated_at TIMESTAMPTZ&lt;br&gt;index advertiser_id · index status" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FCFBFF;strokeColor=#B9A6F0;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="1460" y="345" width="420" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="ads-t2" value="&lt;b&gt;ads.impressions&lt;/b&gt;&lt;br&gt;id BIGSERIAL PK&lt;br&gt;ad_id BIGINT FK advertisements ON DELETE CASCADE&lt;br&gt;user_id BIGINT · served_at TIMESTAMPTZ DEFAULT now()&lt;br&gt;index ad_id · index user_id" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FCFBFF;strokeColor=#B9A6F0;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="1460" y="525" width="420" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ads-t3" value="&lt;b&gt;ads.clicks&lt;/b&gt;&lt;br&gt;id BIGSERIAL PK&lt;br&gt;ad_id BIGINT FK advertisements ON DELETE CASCADE&lt;br&gt;user_id BIGINT · clicked_at TIMESTAMPTZ DEFAULT now()&lt;br&gt;index ad_id · index user_id" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FCFBFF;strokeColor=#B9A6F0;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="1460" y="655" width="420" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ads-e-client" value="/api/ads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="ads-client" target="ads-svc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ads-e-auth" value="interests (best-effort)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#2E7D32;fontColor=#2E7D32;" edge="1" parent="1" source="ads-svc" target="ads-auth">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ads-e-db" value="READ / WRITE ads.*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B9A6F0;fontColor=#6B51A8;" edge="1" parent="1" source="ads-svc" target="ads-pg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ads-fail" value="&lt;b&gt;Failure / degradation matrix&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=#B42318&gt;&lt;b&gt;DB error&lt;/b&gt;&lt;/font&gt; → 500 could not create/update/load ads, could not record click&lt;br&gt;&lt;font color=#B42318&gt;&lt;b&gt;bad input&lt;/b&gt;&lt;/font&gt; → 400 invalid pages/limit/id, title/body/status/budget validation&lt;br&gt;&lt;font color=#2E7D32&gt;&lt;b&gt;auth interests lookup failure&lt;/b&gt;&lt;/font&gt; → warn + serve general ads only (no 5xx)&lt;br&gt;&lt;font color=#2E7D32&gt;&lt;b&gt;impression insert failure&lt;/b&gt;&lt;/font&gt; → logged only; serve response still 200&lt;br&gt;&lt;font color=#5A626E&gt;inventory shortfall&lt;/font&gt; → 200 with fewer ads than ad_count; never an error" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="900" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="ads-contract" value="&lt;b&gt;Contract&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST /ads → 201 ad&lt;br&gt;GET /ads → 200 caller-owned ads&lt;br&gt;PATCH /ads/{id} → 200 · 404 if not owner/missing&lt;br&gt;GET /ads/serve?pages&amp;limit → 200 [{id, advertiser_id,title,body}]&lt;br&gt;POST /ads/{id}/click → 204 · 404&lt;br&gt;&lt;br&gt;Metrics: service=ads, endpoints create_ad/list_ads/update_ad/serve_ads/click_ad/health." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="960" y="810" width="460" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="ads-legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;solid blue = sync HTTP / DB call&lt;br&gt;&lt;font color=#B42318&gt;red dashed = load-bearing failure (abort)&lt;/font&gt;&lt;br&gt;&lt;font color=#2E7D32&gt;green dashed = graceful degradation / fail-open&lt;/font&gt;&lt;br&gt;&lt;font color=#5A626E&gt;gray dashed = metrics scrape&lt;/font&gt;&lt;br&gt;purple = PostgreSQL / persistent storage&lt;br&gt;&lt;br&gt;&lt;b&gt;Runtime&lt;/b&gt;&lt;br&gt;HTTP :8087 · metrics :9097 (ClusterIP) · pages scales ads" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="1440" y="810" width="420" height="250" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
