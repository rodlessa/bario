        <mxCell id="auth-r2" value="handleRegister&lt;br&gt;JSON decode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="auth-register">
          <mxGeometry x="210" y="30" width="160" height="70" as="geometry"/>
