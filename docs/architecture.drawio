        <mxCell id="uploads-svc" value="uploads Deployment — Go · schema uploads · API :8080 · metrics :9090" style="swimlane;startSize=26;fillColor=#F7F8FA;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="1">
