        <mxCell id="posts-deps" value="Outbound HTTP dependencies (clients owned by posts)" style="swimlane;startSize=24;fillColor=#F7F8FA;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1460" y="90" width="420" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="posts-follows" value="&lt;b&gt;follows service&lt;/b&gt; · :8080&lt;br&gt;GET /users/{id}/following&lt;br&gt;&lt;font color=#B42318&gt;LOAD-BEARING: error → 502&lt;/font&gt;&lt;br&gt;&lt;font color=#5A626E&gt;feed cannot be built without it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="posts-deps">
          <mxGeometry x="20" y="40" width="380" height="100" as="geometry"/>
        </mxCell>
