        </mxCell>
        <mxCell id="ads-serve" value="GET /ads/serve?pages=&amp;limit= — handleServeAds" style="swimlane;startSize=22;fillColor=#FFFFFF;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="ads-svc">
          <mxGeometry x="20" y="240" width="1140" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="ads-s1" value="GET /ads/serve&lt;br&gt;RequireAuth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="ads-serve">
          <mxGeometry x="20" y="30" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ads-s2" value="ratio = min(0.30,&lt;br&gt;0.05 + 0.02 × pages)&lt;br&gt;ad_count = round(ratio × limit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="ads-serve">
          <mxGeometry x="230" y="30" width="240" height="80" as="geometry"/>
