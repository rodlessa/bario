        <mxCell id="bario-auth-001-title" value="Bario — auth service (schema auth)" style="text;fontStyle=1;fontSize=16;html=1;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1300" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="bario-auth-001-sub" value="Identity, JWT issuance, public profiles · no outbound clients" style="text;fontSize=12;html=1;fontColor=#5A626E;" vertex="1" parent="1">
