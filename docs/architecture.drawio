        <mxCell id="uploads-u1" value="POST /uploads&lt;br&gt;multipart field file&lt;br&gt;RequireAuth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="uploads-upload">
          <mxGeometry x="20" y="30" width="180" height="80" as="geometry"/>
