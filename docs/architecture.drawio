        <mxCell id="posts-deps" value="Outbound HTTP dependencies (clients owned by posts)" style="swimlane;startSize=24;fillColor=#F7F8FA;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="1">
