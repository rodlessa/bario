        </mxCell>
        <mxCell id="auth-client" value="Browser / Traefik ingress&lt;br&gt;/api/auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="auth-svc" value="auth Deployment — Go · schema auth · API :8080 · metrics :9090" style="swimlane;startSize=26;fillColor=#F7F8FA;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="90" width="1180" height="700" as="geometry"/>
        </mxCell>
        <mxCell id="auth-startup" value="startup: db.Connect → db.Migrate (auth.users) → jwt.Manager (24h) → routes → Serve" style="text;html=1;align=left;fontSize=11;fontColor=#5A626E;" vertex="1" parent="auth-svc">
          <mxGeometry x="20" y="28" width="1120" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="auth-register" value="POST /register — handleRegister" style="swimlane;startSize=22;fillColor=#FFFFFF;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="auth-svc">
          <mxGeometry x="20" y="50" width="1140" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="auth-r1" value="POST /register&lt;br&gt;/api/auth/register" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="auth-register">
          <mxGeometry x="20" y="30" width="170" height="70" as="geometry"/>
