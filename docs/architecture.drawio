        <mxCell id="auth-r3" value="validate&lt;br&gt;username ^[A-Za-z0-9_]{3,32}$&lt;br&gt;password 8–72 · email ≤254&lt;br&gt;interests ≤32 tags × 64 chars" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="auth-register">
          <mxGeometry x="390" y="30" width="250" height="70" as="geometry"/>
