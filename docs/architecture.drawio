        <mxCell id="mod-e-g1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="mod-gore-lane" source="mod-g1" target="mod-g2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="mod-e-g2" value="bytes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="mod-gore-lane" source="mod-g2" target="mod-g3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="mod-e-g3" value="RGB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="mod-gore-lane" source="mod-g3" target="mod-g4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="mod-g5" value="200 prompts&lt;br&gt;graphic violence, gore, blood,&lt;br&gt;a normal photo, everyday scene" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="mod-gore-lane">
          <mxGeometry x="20" y="170" width="350" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="mod-g6" value="400 decode/format&lt;br&gt;413 &gt;10 MiB&lt;br&gt;500 inference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="mod-gore-lane">
          <mxGeometry x="400" y="170" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="mod-e-g4" value="probs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="mod-gore-lane" source="mod-g4" target="mod-g5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="mod-e-g5" value="error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#B42318;fontColor=#B42318;" edge="1" parent="mod-gore-lane" source="mod-g4" target="mod-g6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="mod-gore-metrics" value="metrics :9096&lt;br&gt;service=moderation-gore · endpoint=classify|health&lt;br&gt;actual status incl. 400/413/500" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="mod-gore">
          <mxGeometry x="20" y="400" width="840" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="mod-gore-health" value="GET /healthz (also /api/moderation-gore/healthz) → 200 {status:ok}; CLIP loads before listening" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="mod-gore">
          <mxGeometry x="20" y="490" width="840" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="mod-shared" value="&lt;b&gt;Shared image contract (uploads ↔ sidecars)&lt;/b&gt;&lt;br&gt;JPEG, PNG, GIF, BMP, WebP are accepted by uploads, NSFWJS and CLIP. ICO/TIFF/AVIF are rejected at uploads before any call (Go sniffs ICO as image/x-icon; neither tfjs nor sharp decodes it). WebP is special-cased in NSFWJS via sharp because tfjs cannot decode it; CLIP uses Pillow. Uploads calls both /classify endpoints concurrently with a 5s timeout and 1 MiB response cap; probabilities must sum 0.95–1.05 or uploads treats the classifier as failed. Reject threshold default 0.7 for both." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="900" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="mod-caller" value="&lt;b&gt;Failure / degradation&lt;/b&gt;&lt;br&gt;Sidecar 400/413/500 → uploads sees classifier error. With MODERATION_FAIL_OPEN=false (default) uploads returns 503 and audits; with true it stores moderation_status=unavailable and returns 201. Threshold rejection is uploads&#x27; 451, not a sidecar status. CLIP is zero-shot: out-of-distribution/noisy images can produce overconfident scores near the threshold; use the audit scores and thresholds, do not treat scores as calibrated forensic truth. No DB writes in either sidecar." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="960" y="740" width="460" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="moderation-legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;solid blue = sync HTTP / DB call&lt;br&gt;&lt;font color=#B42318&gt;red dashed = load-bearing failure (abort)&lt;/font&gt;&lt;br&gt;&lt;font color=#2E7D32&gt;green dashed = graceful degradation / fail-open&lt;/font&gt;&lt;br&gt;&lt;font color=#5A626E&gt;gray dashed = metrics scrape&lt;/font&gt;&lt;br&gt;purple = PostgreSQL / persistent storage&lt;br&gt;&lt;br&gt;&lt;b&gt;Runtime&lt;/b&gt;&lt;br&gt;NSFWJS :8085/:9095 · CLIP :8086/:9096 · ClusterIP only" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="1440" y="740" width="420" height="250" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
