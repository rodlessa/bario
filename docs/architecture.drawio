          <mxGeometry x="20" y="160" width="380" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="posts-ads" value="&lt;b&gt;ads service&lt;/b&gt; · :8087&lt;br&gt;GET /ads/serve?pages&amp;amp;limit&lt;br&gt;forwards caller Authorization&lt;br&gt;&lt;font color=#2E7D32&gt;fail-open: error/timeout → no ads (200)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="posts-deps">
          <mxGeometry x="20" y="270" width="380" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="posts-store" value="PostgreSQL — schema posts" style="swimlane;startSize=24;fillColor=#F7F8FA;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1460" y="510" width="420" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="posts-pg" value="PostgreSQL 16 · single instance&lt;br&gt;&lt;font color=#5A626E&gt;pod uid/gid 70 · AppArmor Unconfined&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;" vertex="1" parent="posts-store">
          <mxGeometry x="20" y="40" width="380" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="posts-table" value="&lt;b&gt;posts.posts&lt;/b&gt;&lt;br&gt;&lt;font face=monospace&gt;id BIGSERIAL PK&lt;br&gt;user_id BIGINT NOT NULL&lt;br&gt;content TEXT NOT NULL&lt;br&gt;image_id TEXT NULL&lt;br&gt;created_at TIMESTAMPTZ NOT NULL DEFAULT now()&lt;/font&gt;&lt;br&gt;index posts_user_id_id_idx (user_id, id DESC)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FCFBFF;strokeColor=#B9A6F0;fontColor=#1B1F24;" vertex="1" parent="posts-store">
          <mxGeometry x="20" y="125" width="380" height="155" as="geometry"/>
        </mxCell>

        <mxCell id="posts-failures" value="&lt;b&gt;Failure / degradation matrix&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=#B42318&gt;&lt;b&gt;follows down&lt;/b&gt;&lt;/font&gt; → 502 could not load the accounts you follow · feed aborts (load-bearing)&lt;br&gt;&lt;font color=#B42318&gt;&lt;b&gt;posts DB error/scan&lt;/b&gt;&lt;/font&gt; → 500 · feed: could not load feed · get: could not load post · list: could not load posts · create: could not create post&lt;br&gt;&lt;font color=#2E7D32&gt;&lt;b&gt;ads error / timeout (3s)&lt;/b&gt;&lt;/font&gt; → warn log, ads=nil, 200 organic-only feed (fail-open, never 502)&lt;br&gt;&lt;font color=#2E7D32&gt;&lt;b&gt;auth username lookup down&lt;/b&gt;&lt;/font&gt; → author.username = user-&amp;lt;id&amp;gt; · feed still 200&lt;br&gt;&lt;font color=#B42318&gt;&lt;b&gt;bad input&lt;/b&gt;&lt;/font&gt; → 400 · content empty/&amp;gt;280 · image_id regex · limit/cursor/pages · id&lt;br&gt;&lt;font color=#5A626E&gt;&lt;b&gt;empty follows&lt;/b&gt;&lt;/font&gt; → 200 {items: [], next_cursor: null} · ads are not fetched" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="900" height="250" as="geometry"/>
        </mxCell>

        <mxCell id="posts-contract" value="&lt;b&gt;Feed response contract&lt;/b&gt;&lt;br&gt;&lt;font face=monospace&gt;GET /feed 200&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;items: [&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{kind: 'post', id, user_id, content,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; image_id, created_at, author},&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{kind: 'ad', id, advertiser_id, title, body}&lt;br&gt;&amp;nbsp;&amp;nbsp;],&lt;br&gt;&amp;nbsp;&amp;nbsp;next_cursor: '&amp;lt;last organic post id&amp;gt;' | null&lt;br&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;Ads are re-rolled every request and never participate in cursor pagination.&lt;br&gt;List-user-posts still returns the postList envelope {posts, next_cursor}." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#D5DAE1;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="960" y="810" width="460" height="250" as="geometry"/>
        </mxCell>

        <mxCell id="posts-legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;solid blue = sync HTTP / DB call&lt;br&gt;&lt;font color=#B42318&gt;red dashed = load-bearing failure (abort)&lt;/font&gt;&lt;br&gt;&lt;font color=#2E7D32&gt;green dashed = graceful degradation / fail-open&lt;/font&gt;&lt;br&gt;&lt;font color=#5A626E&gt;gray dashed = metrics scrape&lt;/font&gt;&lt;br&gt;purple = PostgreSQL storage&lt;br&gt;&lt;br&gt;&lt;b&gt;Runtime&lt;/b&gt;&lt;br&gt;HTTP :8080 · metrics :9090 (ClusterIP only)&lt;br&gt;env: DATABASE_URL, JWT_SECRET, AUTH_URL,&lt;br&gt;FOLLOWS_URL, ADS_URL, HTTP_PORT, METRICS_PORT" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="1440" y="810" width="420" height="250" as="geometry"/>
