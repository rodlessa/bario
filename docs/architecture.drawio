        <mxCell id="uploads-upload" value="POST /uploads — handleUpload" style="swimlane;startSize=22;fillColor=#FFFFFF;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="uploads-svc">
