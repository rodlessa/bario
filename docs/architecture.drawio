  <diagram id="bario-posts-001" name="posts service">
    <mxGraphModel dx="1900" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="posts-title" value="Bario — posts service (schema posts, master @ ad4f3c4)" style="text;fontStyle=1;fontSize=16;html=1;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="posts-subtitle" value="Internal handler flow · outbound clients · owned tables · failure/degradation behavior" style="text;fontSize=12;html=1;fontColor=#5A626E;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1000" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="posts-client" value="Browser / Traefik ingress&lt;br&gt;&lt;font color=#5A626E&gt;/api/posts/* · /feed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="posts-prometheus" value="Prometheus&lt;br&gt;&lt;font color=#5A626E&gt;scrape /metrics :9090&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontColor=#1B1F24;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="160" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="posts-svc" value="posts Deployment — Go · schema posts · API :8080 · metrics :9090" style="swimlane;startSize=26;fillColor=#F7F8FA;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="90" width="1180" height="700" as="geometry"/>
        </mxCell>
        <mxCell id="posts-startup" value="startup: db.Connect → db.Migrate (posts schema + index) → jwt.NewManager → registerRoutes → Serve :8080 / :9090" style="text;html=1;align=left;fontSize=11;fontColor=#5A626E;" vertex="1" parent="posts-svc">
          <mxGeometry x="20" y="28" width="1120" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="posts-lane-create" value="POST /posts — handleCreatePost — authenticated write" style="swimlane;startSize=22;fillColor=#FFFFFF;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="posts-svc">
          <mxGeometry x="20" y="50" width="1140" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="posts-c1" value="POST /posts&lt;br&gt;/api/posts&lt;br&gt;/api/posts/posts&lt;br&gt;&lt;font color=#5A626E&gt;RequireAuth JWT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="posts-lane-create">
          <mxGeometry x="20" y="30" width="170" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="posts-c2" value="handleCreatePost&lt;br&gt;&lt;font color=#5A626E&gt;JSON decode&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="posts-lane-create">
          <mxGeometry x="230" y="30" width="170" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="posts-c3" value="validate&lt;br&gt;content 1–280 chars&lt;br&gt;image_id ^[A-Za-z0-9_-]{1,64}$&lt;br&gt;&lt;font color=#B42318&gt;400 on failure&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="posts-lane-create">
          <mxGeometry x="440" y="30" width="230" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="posts-c4" value="INSERT posts.posts&lt;br&gt;RETURNING id, created_at&lt;br&gt;&lt;font color=#B42318&gt;500 on DB error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="posts-lane-create">
          <mxGeometry x="710" y="30" width="250" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="posts-c5" value="201 post JSON&lt;br&gt;&lt;font color=#5A626E&gt;author from JWT claims&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="posts-lane-create">
          <mxGeometry x="1000" y="30" width="120" height="64" as="geometry"/>
        </mxCell>

        <mxCell id="posts-lane-feed" value="GET /feed — handleFeed — ads-interleaved home feed (most failure-prone path)" style="swimlane;startSize=22;fillColor=#FFFFFF;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="posts-svc">
          <mxGeometry x="20" y="160" width="1140" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="posts-f1" value="GET /feed&lt;br&gt;/api/posts/feed&lt;br&gt;&lt;font color=#5A626E&gt;RequireAuth JWT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="posts-lane-feed">
          <mxGeometry x="20" y="30" width="160" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="posts-f2" value="parsePagination&lt;br&gt;limit 1..100 (default 20)&lt;br&gt;cursor id (0 = first page)&lt;br&gt;&lt;font color=#B42318&gt;400 invalid&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="posts-lane-feed">
          <mxGeometry x="210" y="30" width="190" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="posts-f3" value="parsePages&lt;br&gt;pages ≥ 0 (default 0)&lt;br&gt;scales ad density&lt;br&gt;&lt;font color=#B42318&gt;400 invalid&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="posts-lane-feed">
          <mxGeometry x="430" y="30" width="160" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="posts-f4" value="followsClient.FollowingIDs&lt;br&gt;GET /users/{id}/following&lt;br&gt;&lt;font color=#B42318&gt;load-bearing: error → 502&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="posts-lane-feed">
          <mxGeometry x="620" y="30" width="200" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="posts-f6" value="200&lt;br&gt;{items: [],&lt;br&gt;next_cursor: null}&lt;br&gt;&lt;font color=#5A626E&gt;no ads fetched&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="posts-lane-feed">
          <mxGeometry x="850" y="30" width="180" height="84" as="geometry"/>
        </mxCell>

        <mxCell id="posts-g1" value="SELECT posts.posts&lt;br&gt;WHERE user_id = ANY(followed)&lt;br&gt;AND (cursor = 0 OR id &lt; cursor)&lt;br&gt;ORDER BY id DESC LIMIT&lt;br&gt;&lt;font color=#B42318&gt;error/scan → 500&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="posts-lane-feed">
          <mxGeometry x="20" y="150" width="220" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="posts-g2" value="attachAuthors&lt;br&gt;authClient.Username per unique user&lt;br&gt;&lt;font color=#2E7D32&gt;auth down → user-&amp;lt;id&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="posts-lane-feed">
          <mxGeometry x="270" y="150" width="180" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="posts-g3" value="adsClient.Serve&lt;br&gt;GET /ads/serve?pages&amp;amp;limit&lt;br&gt;forwards caller Authorization&lt;br&gt;&lt;font color=#2E7D32&gt;error/timeout (3s) → ads=nil&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="posts-lane-feed">
          <mxGeometry x="480" y="150" width="210" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="posts-g4" value="interleaveFeed&lt;br&gt;ad position =&lt;br&gt;floor((i+1) × P / (A+1))&lt;br&gt;&lt;font color=#5A626E&gt;spread between organic posts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="posts-lane-feed">
          <mxGeometry x="720" y="150" width="200" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="posts-g5" value="200 feedList&lt;br&gt;{items, next_cursor}&lt;br&gt;cursor = last ORGANIC post id&lt;br&gt;&lt;font color=#5A626E&gt;ads re-rolled each request&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="posts-lane-feed">
          <mxGeometry x="950" y="150" width="170" height="84" as="geometry"/>
        </mxCell>

        <mxCell id="posts-lane-get" value="GET /posts/{id} — handleGetPost — public read" style="swimlane;startSize=22;fillColor=#FFFFFF;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="posts-svc">
