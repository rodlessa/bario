        <mxCell id="ads-svc" value="ads Deployment — Go · schema ads · API :8087 · metrics :9097" style="swimlane;startSize=26;fillColor=#F7F8FA;strokeColor=#D5DAE1;html=1;fontColor=#1B1F24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="90" width="1180" height="700" as="geometry"/>
